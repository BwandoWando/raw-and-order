# Copy to .env and adjust. Nested settings use a double underscore.

# --- App
LOG_LEVEL=INFO
DATA_DIR=data
DATABASE_URL=sqlite:///data/app.db
CHECKPOINT_DB_PATH=data/checkpoints.db
PREVIEW_DIR=data/previews
PREVIEW_MAX_PX=1024

# --- Batch size
# Process at most this many photos per run (first by path); the rest wait for
# the next run (1-5000). Override per run with --max-photos.
MAX_PHOTOS_PER_RUN=500
# Photos processed and saved together; an interruption loses at most one chunk
# (1-5000). Override per run with --chunk-size.
CHUNK_SIZE=25

# --- Capture date: sources tried in order (exif_original,xmp,exif_create,filename)
DATE_SOURCES=exif_original,xmp,exif_create,filename

# --- Privacy: what EXIF goes to the LLM
SEND_EXIF_TO_LLM=true
REDACT_GPS=true

# --- LLM: local Ollama (default)
LLM__PROVIDER=ollama
LLM__MODEL=llama3.2-vision
LLM__BASE_URL=http://localhost:11434

# --- LLM: OpenAI
# LLM__PROVIDER=openai
# LLM__MODEL=<model-id>
# LLM__API_KEY=sk-...

# --- LLM: Anthropic
# LLM__PROVIDER=anthropic
# LLM__MODEL=<model-id>
# LLM__API_KEY=sk-ant-...
