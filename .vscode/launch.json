{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "my-agent: process folder",
            "type": "debugpy",
            "request": "launch",
            "module": "my_agent",
            "args": ["process", "${input:sourceDir}", "${input:extraArgs}"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "env": {"PYTHONNOUSERSITE": "1"},
            "justMyCode": true
        },
        {
            "name": "my-agent: process folder (step into libraries)",
            "type": "debugpy",
            "request": "launch",
            "module": "my_agent",
            "args": ["process", "${input:sourceDir}", "${input:extraArgs}"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "env": {"PYTHONNOUSERSITE": "1"},
            "justMyCode": false
        },
        {
            "name": "my-agent: check",
            "type": "debugpy",
            "request": "launch",
            "module": "my_agent",
            "args": ["check"],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "env": {"PYTHONNOUSERSITE": "1"},
            "justMyCode": true
        },
        {
            "name": "pytest: current file",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["${file}", "-x", "-vv"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {"PYTHONNOUSERSITE": "1"},
            "justMyCode": false
        },
        {
            "name": "Streamlit UI",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run", "src/my_agent/ui/app.py",
                "--server.address", "localhost",
                "--browser.gatherUsageStats", "false",
                "--client.toolbarMode", "minimal",
                "--server.runOnSave", "true"
            ],
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "env": {"PYTHONNOUSERSITE": "1"},
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "sourceDir",
            "type": "promptString",
            "description": "Folder with raw files to process",
            "default": "${userHome}/Pictures"
        },
        {
            "id": "extraArgs",
            "type": "pickString",
            "description": "Extra options",
            "options": ["--skip-model-check", "--reprocess", "--no-reprocess"],
            "default": "--no-reprocess"
        }
    ]
}
